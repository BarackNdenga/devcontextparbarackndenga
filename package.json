{
  "name": "devcontext",
  "displayName": "DevContext",
  "description": "Sauvegarde et restauration instantanée de l'état complet de l'espace de travail",
  "version": "1.0.0",
  "publisher": "barack-ndenga",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "Workspace"
  ],
  "activationEvents": [
    "workspaceContains:package.json",
    "onCommand:devcontext.save",
    "onCommand:devcontext.restore",
    "onCommand:devcontext.list",
    "onCommand:devcontext.clear"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devcontext.save",
        "title": "DevContext: Sauvegarder l'état actuel"
      },
      {
        "command": "devcontext.restore",
        "title": "DevContext: Restaurer l'état précédent"
      },
      {
        "command": "devcontext.list",
        "title": "DevContext: Lister les sauvegardes"
      },
      {
        "command": "devcontext.clear",
        "title": "DevContext: Effacer toutes les sauvegardes"
      }
    ],
    "keybindings": [
      {
        "command": "devcontext.save",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      },
      {
        "command": "devcontext.restore",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "devcontext.save",
          "group": "navigation",
          "when": "editorTextFocus"
        }
      ],
      "commandPalette": [
        {
          "command": "devcontext.save",
          "when": "editorTextFocus"
        },
        {
          "command": "devcontext.restore"
        },
        {
          "command": "devcontext.list"
        },
        {
          "command": "devcontext.clear"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.93.0",
    "@types/node": "^20.0.0",
    "typescript": "~5.5.3",
    "vsce": "^2.28.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/barack-ndenga/devcontext.git"
  },
  "bugs": {
    "url": "https://github.com/barack-ndenga/devcontext/issues"
  }
}
